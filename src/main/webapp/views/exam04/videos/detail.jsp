<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Chi tiết ${video.title} - Đề 04</title></head><body><div class="card shadow-sm"><div class="row g-0"><div class="col-md-6"><img class="img-fluid rounded-start w-100 h-100" style="object-fit:cover;min-height:320px" src="${video.poster}" alt="Poster ${video.title}" onerror="this.src='https://placehold.co/600x360?text=No+Image'"></div><div class="col-md-6"><div class="card-body p-4"><h2><c:out value="${video.title}"/></h2><p><strong>Mã video:</strong> ${video.videoId}</p><p><strong>Category:</strong> <c:out value="${video.categoryName}"/></p><div class="d-flex gap-4 mb-3"><span><strong>View:</strong> ${video.views}</span><span><strong>Share:</strong> ${video.shareCount}</span><span><strong>Like:</strong> ${video.likeCount}</span></div><h5>Mô tả</h5><p><c:out value="${video.description}"/></p><a class="btn btn-secondary" href="${pageContext.request.contextPath}/videos?categoryId=${video.categoryId}">Quay lại</a></div></div></div></div></body></html>

