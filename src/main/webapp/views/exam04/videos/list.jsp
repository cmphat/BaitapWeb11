<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Video theo Category - Đề 04</title></head><body><h2 class="fw-bold">Video theo Category</h2><div class="nav nav-pills gap-2 mb-4"><c:forEach items="${categories}" var="c"><a class="nav-link ${selectedCategory.categoryId==c.categoryId?'active':''}" href="${pageContext.request.contextPath}/videos?categoryId=${c.categoryId}"><c:out value="${c.categoryName}"/> (${c.videoCount})</a></c:forEach></div>
<c:if test="${not empty selectedCategory}"><h4><c:out value="${selectedCategory.categoryName}"/> (${videoCount})</h4></c:if><div class="row g-4"><c:forEach items="${videos}" var="v"><div class="col-md-4"><div class="card h-100 shadow-sm"><img class="card-img-top video-poster" src="${v.poster}" alt="Poster ${v.title}" onerror="this.src='https://placehold.co/600x360?text=No+Image'"><div class="card-body"><h5><c:out value="${v.title}"/></h5><p class="small text-muted mb-1">Mã: ${v.videoId}</p><p class="small text-muted">Category: <c:out value="${v.categoryName}"/></p><div class="d-flex gap-3 mb-3"><span>👁 ${v.views}</span><span>↗ ${v.shareCount}</span><span>♥ ${v.likeCount}</span></div><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/video/detail?id=${v.videoId}">Chi tiết</a></div></div></div></c:forEach></div>
<nav class="mt-4"><ul class="pagination justify-content-center"><li class="page-item ${page==1?'disabled':''}"><a class="page-link" href="?categoryId=${selectedCategory.categoryId}&page=${page-1}">&laquo;</a></li><c:forEach begin="1" end="${totalPages}" var="p"><li class="page-item ${p==page?'active':''}"><a class="page-link" href="?categoryId=${selectedCategory.categoryId}&page=${p}">${p}</a></li></c:forEach><li class="page-item ${page==totalPages?'disabled':''}"><a class="page-link" href="?categoryId=${selectedCategory.categoryId}&page=${page+1}">&raquo;</a></li></ul></nav></body></html>

