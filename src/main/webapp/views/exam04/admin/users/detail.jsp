<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Chi tiết User - Đề 04</title></head><body><div class="card shadow-sm"><div class="card-body"><h2>Chi tiết người dùng</h2><dl class="row"><dt class="col-sm-3">Username</dt><dd class="col-sm-9"><c:out value="${user.username}"/></dd><dt class="col-sm-3">Họ tên</dt><dd class="col-sm-9"><c:out value="${user.fullname}"/></dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9"><c:out value="${user.email}"/></dd><dt class="col-sm-3">Điện thoại</dt><dd class="col-sm-9"><c:out value="${user.phone}"/></dd><dt class="col-sm-3">Admin / Active</dt><dd class="col-sm-9">${user.admin?'Có':'Không'} / ${user.active?'Có':'Không'}</dd></dl><a class="btn btn-warning" href="${pageContext.request.contextPath}/admin/users/edit?username=${user.username}">Cập nhật</a> <a class="btn btn-secondary" href="${pageContext.request.contextPath}/admin/users">Quay lại</a></div></div></body></html>

