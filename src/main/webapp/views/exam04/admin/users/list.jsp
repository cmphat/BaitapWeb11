<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Quản lý Users - Đề 04</title></head><body>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2>Quản lý Users</h2><span class="text-muted">Tổng số: ${totalUsers} - 6 users/trang</span></div><a class="btn btn-success" href="${pageContext.request.contextPath}/admin/users/create">Tạo user</a></div>
<c:if test="${param.msg == 'saved'}"><div class="alert alert-success">Lưu người dùng thành công.</div></c:if><c:if test="${param.msg == 'deleted'}"><div class="alert alert-success">Xóa người dùng thành công.</div></c:if><c:if test="${param.error == 'delete'}"><div class="alert alert-danger">Không thể xóa vì người dùng có dữ liệu liên quan.</div></c:if>
<div class="table-responsive bg-white shadow-sm"><table class="table table-hover mb-0"><thead class="table-dark"><tr><th>Username</th><th>Họ tên</th><th>Email</th><th>Admin</th><th>Active</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td><c:out value="${u.username}"/></td><td><c:out value="${u.fullname}"/></td><td><c:out value="${u.email}"/></td><td>${u.admin ? 'Có' : 'Không'}</td><td>${u.active ? 'Có' : 'Không'}</td><td class="text-nowrap"><a class="btn btn-sm btn-info" href="${pageContext.request.contextPath}/admin/users/detail?username=${u.username}">Chi tiết</a> <a class="btn btn-sm btn-warning" href="${pageContext.request.contextPath}/admin/users/edit?username=${u.username}">Sửa</a> <a class="btn btn-sm btn-danger" onclick="return confirm('Xóa user này?')" href="${pageContext.request.contextPath}/admin/users/delete?username=${u.username}">Xóa</a></td></tr></c:forEach></tbody></table></div>
<nav class="mt-3"><ul class="pagination justify-content-center"><li class="page-item ${page==1?'disabled':''}"><a class="page-link" href="?page=${page-1}">Previous</a></li><c:forEach begin="1" end="${totalPages}" var="p"><li class="page-item ${p==page?'active':''}"><a class="page-link" href="?page=${p}">${p}</a></li></c:forEach><li class="page-item ${page==totalPages?'disabled':''}"><a class="page-link" href="?page=${page+1}">Next</a></li></ul></nav></body></html>

